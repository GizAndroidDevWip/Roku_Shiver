<?xml version="1.0" encoding="utf-8"?>
<component name="Comments" extends="Group"
	xsi:noNamespaceSchemaLocation="https://devtools.web.roku.com/schema/RokuSceneGraph.xsd">

	<interface>
		<field id="video_id" type="string" alwaysNotify="true" onChange="callCommentsFetcherTaskApi" />
		<field id="comments" type="roAssociativeArray" />
		<field id="visible" type="boolean" value="true" />
		<field id="aquireFocus" type="boolean" alwaysNotify="true" value="true"
			onChange="onAquireFocus" />
		<field id="closeComments" type="boolean" alwaysNotify="true" value="false" />
	</interface>

	<script type="text/brightscript" uri="pkg:/components/screens/Comments/Comments.brs" />
	<script type="text/brightscript" uri="pkg:/source/commonUtils.brs" />

	<children>

		<Rectangle
			id="main_rect"
			width="840"
			height="1080"
			color="#000000"
			translation="[300,0]"
			visible="true">

			<!-- <Rectangle id="main_rect_bg" width="840" height="1080" color="#000000" /> -->

			<!-- comments -->
			<Rectangle id="comments_bg_rect" width="800" translation="[20,20]"
				height="1080" color="00FFFFFF"
				visible="true">

				<RowList
					id="commentsRowList"
					itemComponentName="customItemForComments"
					itemSize="[770, 260]"
					focusXOffset="[]"
					itemSpacing="[13,8]"
					numRows="4"
					focusBitmapUri=""
					rowLabelOffset="[[0,20]]"
					vertFocusAnimationStyle="fixedfocus"
					rowItemSize="[[770, 260],[770, 260],[770, 260],[770, 260],[770, 260],[770, 260]]"
					rowHeights="[260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260]" />
			</Rectangle>


			<!-- reply -->
			<Rectangle id="reply_bg_rect" width="800" translation="[20,20]"
				height="1080" color="00FFFFFF"
				visible="false">

				<Poster id="userProfilePoster" translation="[20,20]" width="50" height="50"
					loadDisplayMode="limitSize"
					loadWidth="600" loadHeight="300"
					uri=""
					loadSync="true" />

				<Label id="userName" height="55" width="310" wrap="true" lineSpacing="1"
					horizAlign="left"
					vertAlign="top" font="font:SmallestBoldSystemFont" translation="[88,35]"
					numLines="2" size="18"
					maxLines="2">
				</Label>

				<Label id="timePosted" height="90" width="370" wrap="true" lineSpacing="1"
					horizAlign="left"
					vertAlign="top" color="#FFFFFF" visible="true" font="font:smallestSystemFont"
					size="9"
					translation="[567,35]" numLines="2" maxLines="10">
				</Label>

				<ScrollableText id="comment_text" color="#FFFFFF" width="760"
					translation="[60,85]" text="" height="270" lineSpacing="5"
					horizAlign="left">
					<Font role="font" uri="pkg:/fonts/OpenSans-VariableFont_wdth,wght.ttf" size="25" />
				</ScrollableText>

				<RowList
					id="replyRowList"
					itemComponentName="customItemForComments"
					itemSize="[770, 260]"
					focusXOffset="[]"
					translation="[0,400]"
					itemSpacing="[13,8]"
					numRows="4"
					focusBitmapUri=""
					rowLabelOffset="[[0,20]]"
					vertFocusAnimationStyle="fixedfocus"
					rowItemSize="[[770, 260],[770, 260],[770, 260],[770, 260],[770, 260],[770, 260]]"
					rowHeights="[260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260,260]" />
			</Rectangle>
		</Rectangle>

		<Label
			id="noCommentsLabel"
			color="#ffffff"
			text="No comments available!"
			visible="false"
			translation="[195,495]">
			<Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="35" />
		</Label>

		<Timer
			id="replyFetchTimer"
			repeat="true"
			duration="10" />


		<!-- animation sections -->
		<Animation id="comments_open_animation" duration="0.2"
			easeFunction="inOutQuad">
			<Vector2DFieldInterpolator
				id="testVector2D"
				key="[0.0, 1.0]"
				keyValue="[[600, 0],[0, 0]]"
				fieldToInterp="main_rect.translation" />
		</Animation>

		<Animation id="comments_close_animation" duration="0.2"
			easeFunction="inOutQuad">
			<Vector2DFieldInterpolator
				id="testVector2D"
				key="[0.0,  1.0]"
				keyValue="[[0, 0], [600, 0]]"
				fieldToInterp="main_rect.translation" />
		</Animation>
	</children>
</component>