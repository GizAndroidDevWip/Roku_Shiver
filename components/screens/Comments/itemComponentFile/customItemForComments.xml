<component name="customItemForComments" extends="Group">

  <interface>
    <field id="width" type="float" />
    <field id="height" type="float" />
    <field id="itemContent" type="node" onChange="itemContentChanged" />
    <field id="rowHasFocus" type="float" onChange="onRowFocusPercentChanged" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/commonUtils.brs" />
  <script type="text/brightscript"
    uri="pkg:/components/screens/Comments/itemComponentFile/customItemForComments.brs" />
  <script type="text/brightscript">
    <!-- <script type="text/brightscript" uri ="pkg:/source/commonUtils.brs"/> -->


  </script>

  <children>


    <Rectangle id="main_rect" width="" height="" translation="[0,0]" color="#000000"
      visible="true">


      <Poster id="bgPoster" uri="pkg:/images/img_newbg.9.png" blendColor="#303030"
        width="" height="" translation="[0, 0]" />

      <Poster id="userProfilePoster" translation="[20,20]" width="50" height="50"
        loadDisplayMode="limitSize"
        loadWidth="600" loadHeight="300"
        uri=""
        loadSync="true" />

      <Label id="userName" height="55" width="310" wrap="true" lineSpacing="1" horizAlign="left"
        vertAlign="top" font="font:SmallestBoldSystemFont" translation="[88,35]" numLines="2"
        size="18"
        maxLines="2">
      </Label>

      <Label id="timePosted" height="90" width="370" wrap="true" lineSpacing="1" horizAlign="left"
        vertAlign="top" color="#FFFFFF" visible="true" font="font:smallestSystemFont" size="9"
        translation="[400,35]" numLines="2" maxLines="10">
      </Label>

      <Label id="commentText" height="90" width="370" wrap="true" lineSpacing="1" horizAlign="left"
        vertAlign="top" color="#FFFFFF" visible="true" size="1"
        translation="[20,80]" numLines="2" maxLines="1">
        <Font role="font" uri="pkg:/fonts/OpenSans-VariableFont_wdth,wght.ttf" size="" />
      </Label>


      <Poster id="likePoster" uri="pkg:/images/icons/like.png" visible="true"
        translation="" width="25" height="25" />

      <Label id="likeCount" height="90" width="370" wrap="true" lineSpacing="1" horizAlign="left"
        vertAlign="top" color="#FFFFFF" visible="true" font="font:smallestSystemFont" size="11"
        translation="" numLines="2" maxLines="1">
      </Label>


      <Poster id="commentsPoster" uri="pkg:/images/icons/comment.png" visible="true"
        translation="" width="25" height="25" />

      <Label id="commentCount" height="90" width="370" wrap="true" lineSpacing="1" horizAlign="left"
        vertAlign="top" color="#FFFFFF" visible="true" font="font:smallestSystemFont" size="11"
        translation="" numLines="2" maxLines="1">
      </Label>


      <!-- <Poster id="CornerRoundedforComments" uri="pkg:/images/cornerRounded.png" visible="true"
        translation="[0,0]" width="" height="" /> -->


    </Rectangle>

  </children>

</component>