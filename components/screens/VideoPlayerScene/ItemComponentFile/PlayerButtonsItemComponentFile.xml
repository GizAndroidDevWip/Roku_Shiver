<component name="PlayerButtonsItemComponentFile" extends="Group">
    <interface>
        <field id="width" type="float" onChange="updateLayout" />
        <field id="height" type="float" onChange="updateLayout" />
        <field id="itemHasFocus" type="bool" onChange="onitemHasFocus" />
        <field id="rowHasFocus" type="bool" onChange="onRowHasFocus" />
        <field id="itemContent" type="node" onChange="updateContent" />
        <field id="focusPercent" type="float" onChange="onItemFocusPercentchanged" />
    </interface>
    <script type="text/brightscript"
        uri="pkg:/components\screens\VideoPlayerScene\ItemComponentFile\PlayerButtonsItemComponentFile.brs" />

    <script type="text/brightscript"
        uri="pkg:/source/commonUtils.brs" />
    <children>
        <!-- Capsule background -->
        <Rectangle
            id="bg"
            width="200"
            height="60"
            translation="[0,0]"
            Color="#00000000" />

        <Poster
            id="bgPoster"
            width="200"
            height="60"
            opacity="0.2"
            uri="pkg:/images/img_newbg.9.png"
            translation="[0,0]"
            visible="true" />

        <Rectangle
            id="watchProgressContainer"
            width="200"
            height="5"
            translation="[0,0]"
            color="0x00000000"
            visible="false">

            <Poster
                id="watchProgressLineBg"
                width="200"
                height="5"
                opacity="0.2"
                uri="pkg:/images/img_itemcatbg_selected.png"
                translation="[0,0]"
                visible="true" />

            <Poster
                id="watchProgressLine"
                width="100" height="5" uri="pkg:/images/img_itemcatbg_selected.png"
                translation="[0,0]" visible="true" />
        </Rectangle>


        <!-- Icon -->
        <Poster
            id="buttonLeftIcon"
            translation="[15,15]"
            width="20"
            height="20"
            visible="false" />

        <!-- Label -->
        <Label
            id="label"
            translation="[0,0]"
            width="200"
            height="60"
            color="#ffffff"
            horizAlign="center"
            vertAlign="center"
            visible="true"
            text="">
            <Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="24" />
        </Label>


        <Rectangle
            id="bg_forIcon"
            width="60"
            height="60"
            visible="false"
            blendColor="#00000000" />

        <!-- Icon -->
        <Poster
            id="icon"
            width="47"
            height="47"
            visible="false"
            uri=""
            translation="[15,15]" />

        <!-- Small Label at the Bottom -->
        <Label
            id="iconLabel"
            translation="[-9,75]"
            width="260"
            height="150"
            lineSpacing="0.1"
            color="#ffffff"
            horizAlign="center"
            vertAlign="top"
            wrap="true"
            visible="false"
            text="">
            <Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="18" />
        </Label>


    </children>
</component>