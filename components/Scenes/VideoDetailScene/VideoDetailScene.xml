<?xml version="1.0" encoding="utf-8"?>

<component name="VideoDetailScene" extends="Group"
    xsi:noNamespaceSchemaLocation="https://devtools.web.roku.com/schema/RokuSceneGraph.xsd">

    <interface>
        <!-- Grid Content Node -->

        <field id="videoId" type="Integer" alwaysnotify="true" onChange="getVideoDetailsAPI" />


        <field id="startLoading" type="String" alwaysnotify="true" />

        <field id="content" type="node" onChange="onContentChange" />

        <field id="selectedlanguageid" type="String" alwaysnotify="true" />

        <field id="channelid" type="String" alwaysnotify="true" />

        <field id="isChildrensVisible" type="bool" alwaysnotify="true" />

        <field id="dialogAuthExceed" type="node" />
        <field id="sessionExpiredPopUp" type="node" />

        <!-- Interface to focused item (Content Node) -->
        <field id="focusedContent" type="node" />

        <field id="focusedRow" type="intarray" alwaysnotify="true" />

        <field id="GloBoolean" type="boolean" alwaysNotify="true" />

        <field id="loading" type="node" />

        <field id="loginDialog" type="node" />

        <field id="subscriptionDialog" type="node" />

        <field id="tagsRowlistContent" alwaysnotify="true" type="node" />

        <field id="gotoLandingScene" type="boolean" alwaysNotify="true" />
        <field id="goToLandingSceneAndCloseAllScreens" type="boolean" alwaysNotify="true" />

        <field id="goToShowMoreScene" type="intarray" alwaysnotify="true" />

        <field id="goToPaymentDescriptionScreen" type="intarray" alwaysnotify="true" />


        <field id="onclosethispage6" type="bool" alwaysnotify="true" />
        <field id="closethispage" type="bool" alwaysnotify="true" />
        <field id="goToVideoPlayerScene" type="intarray" alwaysnotify="true" />
        <field id="ai_type" type="string" alwaysnotify="true" />

        <field id="show_id" type="string" alwaysnotify="true" />

    </interface>

    <!-- main handler -->
    <script type="text/brightscript"
        uri="pkg:/components/Scenes/VideoDetailScene/VideoDetailScene.brs" />

    <script type="text/brightscript" uri="pkg:/source/apis.brs" />
    <script type="text/brightscript" uri="pkg:/source/commonUtils.brs" />
    <script type="text/brightscript" uri="pkg:/source/Strings.brs" />

    <children>

        <Rectangle id="main_rect" width="1920" height="1080" color="#000000">


            <Poster id="backGroundBannerPoster"
                width="1920"
                height="1080"
                visible="true"
                uri=""
                translation="[0,0]" />

            <Poster id="bannerPosterGradient"
                width="1920"
                height="1080"
                opacity="0.9"
                uri="pkg:/images/home_gradient2.png"
                loadDisplayMode="noScale"
                translation="[0,0]" />

            <Rectangle id="metadataRect">
                <LayoutGroup id="LabelGroup" translation="[95, 100]" layoutDirection="vert"
                    vertAlignment="top" itemSpacings="[15,5,5,5,5,5,5,5,5,5]">
                    <!-- <ScrollingLabel id="Title" maxWidth="1600" color="#FFFFFF"
                        vertAlign="bottom"
                        wrap="true"
                        numLines="2"
                        maxLines="2"
                        font="font:LargeBoldSystemFont" text="" horizAlign="left" /> -->

                    <Label
                        id="Title"
                        visible="true"
                        maxWidth="900"
                        width="900"
                        translation="[0,0]"
                        wrap="true"
                        numLines="2"
                        maxLines="2"
                        lineSpacing="-17"
                        horizAlign="left"
                        vertAlign="bottom"
                        color="#ffffff">
                        <Font role="font" uri="pkg:/fonts/Roboto-Bold.ttf" size="55" />
                    </Label>


                    <Label id="resolution" width="1200" horizAlign="left" vertAlign="top"
                        color="#6b6b6b" text="">
                        <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="24" />
                    </Label>

                    <Label id="categories" width="1200" horizAlign="left" vertAlign="top"
                        color="#6b6b6b" text="">
                        <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="27" />
                    </Label>

                    <Label id="description" width="1680" wrap="true" numLines="8" maxLines="8"
                        height="269"
                        lineSpacing="1" horizAlign="left" vertAlign="top" color="#FFFFFF"
                        text="">
                        <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="24" />
                    </Label>
                </LayoutGroup>

                <Rectangle id="buttonRectangle" translation="[0,30]">
                    <LabelList
                        id="buttonsLabelList" visible="true"
                        translation="[111,630]"
                        focusedColor="#ffffff"
                        numRows="3"
                        vertFocusAnimationStyle="floatingFocus"
                        itemSize="[500,70]">
                    </LabelList>
                </Rectangle>

            </Rectangle>

            <Rectangle id="tagsRect" color="00FFFFFF" visible="false" width="1920" height="1080">
                <Rectangle color="#000000" height="1080" width="1920" opacity="0.9" />

                <Poster id="TagsBgPoster" uri="pkg:/images/img_newbg.9.png"
                    width="1200" height="923" translation="[426, 83]" />
                <RowList
                    id="tagsRowlist" label="" focusBitmapUri=""
                    itemComponentName="tagsListItemComponentFile"
                    translation="[505,145]"
                    numRows="7"
                    rowHeights="" rowItemSize="" focusXOffset="[0]"
                    rowItemSpacing="[[30, 20], [30, 20]]" variableWidthItems="[true]"
                    showRowLabel="true" itemSpacing="[0, 33]"
                    itemSize="[1920, 106]" rowLabelOffset="[[0, 0]]"
                    vertFocusAnimationStyle="floatingFocus"
                    rowFocusAnimationStyle="floatingFocus">
                </RowList>
            </Rectangle>

            <!-- Dialog rectangle -->
            <Rectangle id="dialogbg_rect" width="1920" height="1080" translation="[0,0]"
                color="#00000099" visible="false">

                <Rectangle id="dialogmain_rect" width="750" height="365" translation="[587,360]"
                    color="#00000000" visible="true">

                    <Poster id="dialogbanner_poster" loadDisplayMode="noScale" width="750"
                        height="365"
                        loadWidth="498" loadHeight="280" translation="[0,0]"
                        uri="pkg:/images/img_newbg.9.png" visible="true" />


                    <Label id="dialogmessage_label" width="750" height="36" text=""
                        horizAlign="center" vertAlign="center" visible="true" translation="[0,60]"
                        color="#080808">
                        <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="24" />
                    </Label>

                    <Button id="NoButton" text="" height="60" visible="true"
                        showFocusFootprint="true"
                        minWidth="180" translation="[79,210]" iconUri="" focusedIconUri=""
                        focusFootprintBitmapUri="pkg:/images/img_loginbg.png"
                        focusBitmapUri="pkg:/images/img_loginbg_selected.png" textColor="#ffffff"
                        focusedTextColor="#ffffff">
                        <ScrollingLabel id="cancelbutton_Label" height="80" width="300" text=""
                            maxWidth="290" repeatCount="-1"
                            vertAlign="center" horizAlign="center" color="#ffffff">
                            <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="28" />
                        </ScrollingLabel>
                    </Button>


                    <Button id="YesButton" text="" height="60" visible="true"
                        showFocusFootprint="true"
                        minWidth="180" translation="[454,210]" iconUri="" focusedIconUri=""
                        focusFootprintBitmapUri="pkg:/images/img_loginbg.png"
                        focusBitmapUri="pkg:/images/img_loginbg_selected.png" textColor="#ffffff"
                        focusedTextColor="#ffffff">
                        <Label id="exitbutton_Label" height="60" width="180" text="Subscribe"
                            vertAlign="center" horizAlign="center" color="#ffffff">
                            <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="24" />
                        </Label>
                    </Button>
                </Rectangle>

            </Rectangle>

            <!-- up next section -->
            <Rectangle id="UpNext_rect" width="1920" height="1080" color="#000000" visible="false">
                <Label id="Upnext_mainTitle" translation="[0, -150]" height="1080" width="1920"
                    font="font:LargeBoldSystemFont" visible="true" horizAlign="center" wrap="true"
                    vertAlign="center" text=""
                    color="#E3E3E3" size="40" />

                <Label id="upnext_video_name" translation="[460, 0]" height="1080" width="1000"
                    font="font:MediumBoldSystemFont" visible="true" horizAlign="center" wrap="true"
                    vertAlign="center"
                    text=""
                    color="#E3E3E3" size="40" />
            </Rectangle>

            <Video
                id="Video1" visible="false"
                translation="[0,0]"
                width="1920"
                height="1080" contentIsPlaylist="true" />

            <Poster id="Image" translation="[50,30]" width="1200" height="300" />

            <Timer
                id="upNextTimer"
                repeat="false"
                duration="2" />


            <Loading id="loading" />

        </Rectangle>
    </children>

</component>