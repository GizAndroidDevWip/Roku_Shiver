<?xml version="1.0" encoding="utf-8"?>

<component name="Player" extends="Group">
    <interface>
        <field id="content" type="node" />
        <field id="visibility" type="bool" alwaysNotify="true" />
        <field id="state" type="string" alwaysNotify="true" />
        <field id="playerState" type="string" alwaysNotify="true" />
        <field id="autoplay" type="bool" alwaysNotify="true" />
        <field id="subtitles" type="Array" alwaysNotify="true" />
        <field id="control" type="string" alwaysNotify="true" onChange="controlChanged" />
        <field id="skipAd" type="bool" />
        <field id="watched_duration" type="integer" />
        <field id="VIDEO_LANGUAGE_CHANGED" type="string" alwaysNotify="true" />
        <field id="new_videoId" type="string" alwaysNotify="true" />
        <field id="previous_videoId" type="string" alwaysNotify="true" />
        <field id="stop_upNext_timer" type="bool" alwaysNotify="true" />
        <field id="upnext_screen_finished_showing" type="bool" alwaysNotify="true"
            onChange="onUpnextScreenFinishedShowing" />
        <field id="ai_type" type="string" alwaysNotify="true" />
        <field id="video_type" type="string" alwaysNotify="true" />
        <field id="show_id" type="string" alwaysNotify="true" />
        <field id="action_command" type="string" alwaysNotify="true" />
        <field id="you_may_also_like_show_id" type="string" alwaysNotify="true" />

    </interface>

    <script type="text/brightscript" uri="pkg:/components/Ads/Player.brs" />
    <script type="text/brightscript" uri="pkg:/source/apis.brs" />
    <script type="text/brightscript" uri="pkg:/source/commonUtils.brs" />
    <script type="text/brightscript" uri="pkg:/source/Strings.brs" />

    <children>

        <Video
            id="Video" visible="true"
            translation="[0,0]"
            width="1920"
            height="1080" />


        <!-- player overlay -  bottom menu and similar shows rowlist-->
        <Rectangle id="player_overlay_rect" color="00FFFFFF" height="1080" width="1920"
            translation="[0,400]"
            visible="false">

            <Poster id="bottom_gradient" uri="pkg:/images/img_newbottomshade.png" visible="true"
                translation="[0,-465]" width="1920" height="1409" />

            <!-- bottom menu grid -->

            <RowList
                id="buttonsRowlist"
                itemComponentName="PlayerButtonsItemComponentFile"
                itemSize="[1700, 60]"
                focusXOffset="[10]"
                variablewidthitems="[true]"
                drawFocusFeedbackOnTop="false"
                focusBitmapUri="pkg:/images/img_newbg.9.png"
                itemSpacing="[30,30]"
                rowItemSpacing="[[30, 30]]"
                translation="[80, 510]"
                numRows="1"
                rowItemSize="[[200, 70]]"
                rowHeights="[130]" />


            <!-- similar shows rowlist -->
            <RowList
                id="overlayRowlist" label="" focusBitmapUri="pkg:/images/focus_grid.9.png"
                itemComponentName="PlayerOverlyaRowlistItemComponent"
                translation="[80,641]"
                numRows="4" rowLabelFont="font:SmallBoldSystemFont"
                rowHeights="[300,300]" rowItemSize="[[320, 180]]"
                rowItemSpacing="[[45, 45]]"
                showRowLabel="true"
                itemSize="[1860, 518]" rowLabelOffset="[[0, 15]]"
                rowFocusAnimationStyle="floatingFocus">
            </RowList>
        </Rectangle>


        <!-- language label list  -->
        <Rectangle id="languageLbllist_react" width="1920" height="1080"
            translation="[0,0]" color="#000000" visible="true">
            <Label id="language_Lbl" translation="[840,203]" height="38" size="40" width="360"
                color="#FBFBFB" filltype="solid"
                font="font:MediumBoldSystemFont"
                text="Select Language" />
            <LabelList id="selectLanguage" translation="[729,315]" textHorizAlign="center"
                numRows="7"
                font="font:SmallestSystemFont" visible="true" focusedColor="#ffffff" width="680"
                height="480"
                vertFocusAnimationStyle="floatingFocus">
            </LabelList>
        </Rectangle>

        <!-- resolution label list  -->
        <Rectangle id="resolutionLbllist_rect" width="1920" height="1080"
            translation="[0,0]" color="#000000" visible="true">
            <Label id="resolution_Lbl" translation="[840,203]" height="38" size="40" width="360"
                color="#FBFBFB" filltype="solid"
                font="font:MediumBoldSystemFont"
                text="Select Resolution" />
            <LabelList id="resolution_labellist" translation="[729,315]" textHorizAlign="center"
                numRows="7"
                font="font:SmallestSystemFont" visible="true" focusedColor="#ffffff" width="680"
                height="480"
                vertFocusAnimationStyle="floatingFocus">
            </LabelList>
        </Rectangle>

        <!-- player speed label list  -->
        <Rectangle id="speedLbllist_rect" width="1920" height="1080"
            translation="[0,0]" color="#000000" visible="true">
            <Label id="speed_Lbl" translation="[850,203]" height="38" size="40" width="360"
                color="#FBFBFB" filltype="solid"
                font="font:MediumBoldSystemFont"
                text="Select Speed" />
            <LabelList id="speed_labellist" translation="[729,315]" textHorizAlign="center"
                numRows="8"
                font="font:SmallestSystemFont" visible="true" focusedColor="#ffffff" width="680"
                height="480"
                vertFocusAnimationStyle="floatingFocus">
            </LabelList>
        </Rectangle>

        <Timer
            id="makeVisibleTimer"
            repeat="false"
            duration="10" />

        <Timer
            id="makeHideTimer"
            repeat="false"
            duration="16" />

        <!-- <Video id="video" width="1920" height="1080"
                translation="[0,0]" enableUI="true" visible="true" loop="false" /> -->

        <!-- animation sections -->
        <Animation id="player_overlay_open_animation" duration="0.1"
            easeFunction="linear">
            <Vector2DFieldInterpolator
                id="testVector2D"
                key="[0.0, 1.0]"
                keyValue="[[0, 400],[0, 150]]"
                fieldToInterp="player_overlay_rect.translation" />
        </Animation>

        <Animation id="player_overlay_hide_animation" duration="0.1"
            easeFunction="linear">
            <Vector2DFieldInterpolator
                id="testVector2D"
                key="[0.0,  1.0]"
                keyValue="[[0, 150], [0, 400]]"
                fieldToInterp="player_overlay_rect.translation" />
        </Animation>

        <Animation id="video_shrink_animation" duration="0.2" easeFunction="inOutQuad">
            <FloatFieldInterpolator
                id="video_shrink_animation"
                key="[0.0, 1.0]"
                keyValue="[1920, 1080]"
                fieldToInterp="Video.width" />
        </Animation>

        <Animation id="video_expand_animation" duration="0.2" easeFunction="inOutQuad">
            <FloatFieldInterpolator
                id="video_expand_animation"
                key="[0.0, 1.0]"
                keyValue="[1080, 1920]"
                fieldToInterp="Video.width" />
        </Animation>

    </children>
</component>