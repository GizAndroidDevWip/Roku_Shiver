<?xml version="1.0" encoding="utf-8"?>

<component name="GridScreen" extends="Group" initialFocus="RowList"
	xsi:noNamespaceSchemaLocation="https://devtools.web.roku.com/schema/RokuSceneGraph.xsd">
	<interface>
		<!-- Grid Content Node -->

		<field id="homeType" type="String" alwaysnotify="true" />

		<field id="content" type="node" alias="RowList.content" onChange="onContentChange" />

		<field id="selectedlanguageid" type="String" alwaysnotify="true" />

		<field id="channelid" type="String" alwaysnotify="true" />

		<!-- Row item selection handler -->
		<field id="rowItemSelected" type="intarray" alwaysnotify="true"
			alias="RowList.rowItemSelected" onChange="OnItemSelected" />

		<!-- Row item focused handler -->
		<field id="itemFocused" type="intarray" alias="RowList.rowItemFocused"
			 />
		<!-- 
			<field id="itemUnFocused" type="intarray" alias="RowList.rowItemUnFocused"
			onChange="OnItemUnFocused" /> -->

		<!-- Interface to focused item (Content Node) -->
		<field id="focusedContent" type="node" />

		<field id="focusedRow" type="intarray" alwaysnotify="true" />

		<field id="GloBoolean" type="boolean" alwaysNotify="true" />
		<field id="stopAutobannerScroll" type="boolean" alwaysNotify="true"
			onChange="stopAutobannerScroll" />

		<field id="focusBitmapUri" type="uri" alias="RowList.focusBitmapUri" alwaysNotify="true" />
		<field id="liveLinkIfLiveVideoAvailable" type="bool" alwaysNotify="false" />
		<field id="goToTimeGridScene" type="bool" alwaysNotify="true" />
		<field id="onDeepLinkLaunchedGotoShowScene" type="String" alwaysNotify="true" />
		<field id="releasePlayer" type="bool" alwaysNotify="true" onChange="OnreleasePlayer" />
		<field id="callHomeEnlargeAnimation" type="bool" alwaysNotify="true"
			onChange="onHomeEnlargeAnimationCalled" />
		<field id="callHomeShrinkAnimation" type="bool" alwaysNotify="true"
			onChange="onHomeShrinkAnimationCalled" />
		<field id="lastFocusedNode" type="string" alwaysNotify="true" />
		<field id="selectedBannerItem" type="roAssociativeArray" alwaysnotify="true" />
		<field id="categorynodefocus" type="boolean" alwaysnotify="true" />
		<field id="setFocusToTopMenu" type="boolean" alwaysnotify="true" />

	</interface>

	<!-- main handler -->
	<script type="text/brightscript" uri="pkg:/components/Scenes/GridScreen/GridScreen.brs" />
