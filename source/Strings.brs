function getTextOf(key as string) as string
  appStrings = getStrings()

  if m.global.language_keywords <> invalid and m.global.language_keywords[key] <> invalid and m.global.language_keywords[key][getLanguageCodeSelected5()] <> invalid
    return m.global.language_keywords[key][getLanguageCodeSelected5()]
  end if

  if appStrings <> invalid and appStrings[key] <> invalid
    return appStrings[key]
  end if

  return "" ' safe fallback
end function

function getLanguageCodeSelected5() as string
  ses = CreateObject("roRegistrySection", m.global.APP_KEY)
  if ses.Exists("LANGUAGE_CODE_SELECTED")
    value = ses.Read("LANGUAGE_CODE_SELECTED")
    return value
  else
    return "en"
  end if
end function


'------------------------------ Colors ------------------------------

function getColors() as object
  return {
    background_color1: "#000000"
    background_color2: "#000000"
    text_color: "#ffffff"
    sub_text_color: "#999999"
  }
end function


function getColor(key as string) as string
  appColors = getColors()

  if appColors <> invalid and appColors[key] <> invalid
    return appColors[key]
  end if

  return "" ' safe fallback
end function